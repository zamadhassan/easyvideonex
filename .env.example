# Backend API URL (Render FastAPI backend)
# In production, set this in Vercel to your Render service URL.
# Leave empty locally to use the local Python script or JS fallback strategies.
BACKEND_API_URL=

# Public backend API URL (exposed to client-side - only set if you want
# the browser to call the backend directly instead of proxying through Vercel)
# IMPORTANT: Only use this if your backend has CORS configured
# NEXT_PUBLIC_BACKEND_API_URL=

# Rate limiting - max requests per IP per minute
RATE_LIMIT_MAX=30
