# Backend API URL (Render FastAPI backend)
# In production, set this in Vercel to your Render service URL.
# Leave empty locally to use the local Python script or JS fallback strategies.
BACKEND_API_URL=

# Optional: Netscape-format YouTube cookies for videos that trigger
# "Sign in to confirm you're not a bot" in yt-dlp.
# Store the full cookies.txt content with \n line breaks in Vercel if needed.
YOUTUBE_COOKIES=

# Recommended for Vercel: base64-encoded cookies.txt content.
# This avoids multiline environment variable formatting issues.
YOUTUBE_COOKIES_B64=

# Rate limiting - max requests per IP per minute
RATE_LIMIT_MAX=30
